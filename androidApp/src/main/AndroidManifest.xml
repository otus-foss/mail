<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application
    android:name=".OtusMailApplication"
    android:allowBackup="false"
    android:fullBackupContent="@xml/backup_rules"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/otus_mail_icon_otus_blue"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/OtusTheme"
  >
    <!-- Every WebView, for message bodies and printing, keeps usage metrics and the addresses it loads from Google. -->
    <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
    <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
    <!-- One activity, so a tapped alert or a mailto: link reaches the Mail that is already open. -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
    >
      <!-- mailto: links (RFC 6068) open a draft; MailIntents.kt reads them. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="mailto" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SENDTO" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="mailto" />
      </intent-filter>
    </activity>
    <!-- One launcher entry per app icon; LauncherIcon.kt enables the one the settings pick. -->
    <activity-alias
      android:name=".icon.OtusBlue"
      android:enabled="true"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_otus_blue"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Sky"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_sky"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Blue"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_blue"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Violet"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_violet"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Pink"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_pink"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Orange"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_orange"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Green"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_green"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Monochrome"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_monochrome"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Chrome"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_chrome"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Rainbow"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_rainbow"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Trans"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_trans"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Bi"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_bi"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".icon.Lesbian"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/otus_mail_icon_lesbian"
      android:targetActivity=".MainActivity"
    >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <!--
      Opens the message of a tapped alert, then Mail. Not exported, so only Mail's own alerts reach it;
      its own task keeps it out of Mail's task and the recent apps list.
    -->
    <activity
      android:name=".AlertOpenActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.NoDisplay"
    />
    <service android:name=".MailPushService" android:exported="false">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
      </intent-filter>
    </service>
    <!-- Hears the Archive and Mark read buttons on new-mail alerts. -->
    <receiver android:name=".AlertActionReceiver" android:exported="false" />
    <!-- Lends opened attachments to the app that shows them, one file at a time. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.files"
      android:exported="false"
      android:grantUriPermissions="true"
    >
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_files" />
    </provider>
    <!-- WorkManager starts on demand from OtusMailApplication's configuration. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge"
    >
      <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
    </provider>
  </application>
</manifest>
